{
  "name": "clair-due-diligence",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose stop",
    "local:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup.ps1",
    "local:backup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/backup.ps1",
    "local:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start.ps1",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "demo:seed": "tsx scripts/demo.ts",
    "demo:reset": "tsx scripts/demo.ts --reset",
    "demo:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-demo.ps1"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.60.0",
    "next": "^16.4.2",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "prettier": "^3.9.10",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2"
  },
  "engines": {
    "node": "24.x"
  }
}
